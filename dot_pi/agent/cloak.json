{
  "enabled": true,
  "cloakCharacter": "*",
  "cloakLength": null,
  "tryAllPatterns": true,
  "patters": [
    {
      "filePattern": "**/*.env*",
      "cloakPattern": "(=).+",
      "replace": "$1"
    },
    {
      "filePattern": ["~/.pi/agent/auth.json", "**/.pi/agent/auth.json", "**/auth.json"],
      "cloakPattern": [
        {
          "pattern": "(\\\"(?:token|access|refresh|accessToken|refreshToken|apiKey|secret|password|clientSecret|idToken|sessionToken|authorization)\\\"\\s*:\\s*\\\")[^\\\"]+",
          "replace": "$1"
        }
      ]
    },
    {
      "filePattern": "**/*.opencode.json",
      "cloakPattern": "(\\\"apikey\\\"\\s*:\\s*\\\")[^\\\"]+",
      "replace": "$1"
    },
    {
      "filePattern": "**/opencode.json",
      "cloakPattern": "(\\\"apiKey\\\"\\s*:\\s*\\\")[\\\"]+",
      "replace": "$1"
    }
  ]
}
