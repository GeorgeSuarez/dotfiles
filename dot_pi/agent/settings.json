{
  "lastChangelogVersion": "0.84.3",
  "theme": "dark",
  "defaultProvider": "opencode-go",
  "defaultModel": "glm-5.3-flash",
  "defaultThinkingLevel": "max",
  "enabledModels": ["opencode-go/glm-5.3-flash", "opencode-go/gpt-5.6-luna"],
  "thinkingBudgets": {
    "minimal": 1024,
    "low": 4096,
    "medium": 10240,
    "high": 32768
