*.log
*.bak
node_modules/

# Secrets — applied by chezmoi but never committed
# Note: `private_` prefix in source means 0600 in $HOME
# (home/dot_pi/agent/private_auth.json -> ~/.pi/agent/auth.json).
home/dot_pi/agent/private_auth.json
home/dot_pi/agent/private_models-store.json
home/dot_pi/agent/sessions/
home/dot_pi/research/*

# Runtime state / secrets — never `chezmoi add` + commit these
# (live-only today; listed here so an accidental add stays untracked)
home/dot_pi/agent/mcp-cache.json
home/dot_pi/agent/mcp-onboarding.json
home/dot_pi/agent/*.bak
home/dot_config/opencode/service.json
home/dot_config/opencode/cli.json
home/dot_config/opencode/tui.jsonc
home/dot_config/opencode/herdr-tui-session.js
home/dot_config/herdr/*.log
home/dot_config/herdr/plugins/
