home/dot_config/herdr/session-history.json
home/dot_config/herdr/release-notes.json
home/dot_config/herdr/.plugins.lock
home/dot_config/herdr/*.sock

# Live-generated by install.sh (clone location varies per machine) — never commit
home/dot_config/chezmoi/chezmoi.toml
