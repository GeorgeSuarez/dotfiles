.DS_Store
*.log
*.bak
node_modules/

# Secrets — applied by chezmoi but never committed
# Note: `private_` prefix in source means 0600 in $HOME
# (dot_pi/agent/private_auth.json -> ~/.pi/agent/auth.json).
dot_pi/agent/private_auth.json
dot_pi/agent/private_models-store.json
dot_pi/agent/sessions/
dot_pi/research/*

# Runtime state / secrets — never `chezmoi add` + commit these
# (live-only today; listed here so an accidental add stays untracked)
dot_pi/agent/mcp-cache.json
dot_pi/agent/mcp-onboarding.json
dot_pi/agent/*.bak
dot_config/opencode/service.json
dot_config/opencode/cli.json
dot_config/opencode/tui.jsonc
dot_config/opencode/herdr-tui-session.js
dot_config/herdr/*.log
dot_config/herdr/plugins/
dot_config/herdr/session.json
